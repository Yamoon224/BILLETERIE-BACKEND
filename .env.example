APP_NAME="Billetterie interurbaine"
APP_ENV=local
# Genere par `php artisan key:generate` — ne jamais committer de vraie cle.
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Abidjan
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Base de donnees ---------------------------------------------------------
# MySQL 8. La base doit exister avant la premiere migration :
#   CREATE DATABASE billeterie CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=billeterie
DB_USERNAME=root
DB_PASSWORD=

# Base dediee aux tests : elle est videe a chaque execution de la suite, ne
# jamais y pointer la base applicative.
DB_TEST_DATABASE=billeterie_testing

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="billetterie@example.test"
MAIL_FROM_NAME="${APP_NAME}"

# --- Frontend / CORS ---------------------------------------------------------
# Origines autorisees a appeler l API (application Next.js et application
# agent). Separer par des virgules pour en declarer plusieurs.
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Duree de validite d un jeton d API, en minutes. Passe ce delai l API repond
# 401 et le frontend referme la session de lui-meme.
#
# Volontairement long pour le guichet : un agent en gare travaille une journee
# entiere, parfois hors reseau, et une reconnexion en milieu de vacation
# bloquerait la file d attente.
SANCTUM_TOKEN_EXPIRATION=720

# --- Billetterie -------------------------------------------------------------
# Devise unique du lot : franc CFA (XOF), sans sous-unite. Les montants sont
# stockes en entiers ; voir App\Domains\Shared\Support\Money.
TICKETING_CURRENCY=XOF

# Duree pendant laquelle des places restent bloquees pour une reservation en
# ligne non payee. Passe ce delai, la reservation expire et les places
# retournent a la vente (voir `php artisan bookings:expire`).
#
# Quinze minutes : assez pour valider un paiement mobile money sur un reseau
# 2G lent, assez peu pour ne pas geler un bus la veille d une fete.
TICKETING_HOLD_MINUTES=15

# Secret de signature des QR codes. DOIT etre distinct de APP_KEY : un billet
# imprime est verifie hors ligne par l application agent, qui embarque donc ce
# secret — lui confier la cle de chiffrement de l application entiere serait
# disproportionne. Genere par `php artisan ticketing:generate-signing-key`.
TICKETING_SIGNING_KEY=

# Version de la grille de signature des billets. A incrementer lors d une
# rotation de secret : les billets emis sous l ancienne version restent
# verifiables tant qu elle figure dans TICKETING_ACCEPTED_KEY_VERSIONS.
TICKETING_KEY_VERSION=1

# Commission plateforme par defaut, en pour mille du montant encaisse.
# Exprimee en pour mille et non en pourcentage : 2,5 % ne s ecrit pas en
# entier, et un flottant sur une assiette financiere finit toujours par
# produire un centime introuvable.
TICKETING_COMMISSION_PER_MILLE=25

# --- Paiement mobile money ---------------------------------------------------
# Agregateur tiers. `simulated` rejoue le cycle complet (en attente -> succes
# ou echec) sans appel reseau : c est le pilote utilise en local et en test.
# Aucune donnee de paiement n est stockee en propre, quelle que soit la valeur.
PAYMENT_GATEWAY=simulated
PAYMENT_GATEWAY_BASE_URL=
PAYMENT_GATEWAY_API_KEY=
# Secret de verification des rappels (webhooks) de l agregateur.
PAYMENT_GATEWAY_WEBHOOK_SECRET=

# --- Notifications -----------------------------------------------------------
# Canal d envoi du billet electronique. `log` ecrit dans les journaux au lieu
# d appeler un operateur : c est le pilote de developpement.
NOTIFICATION_DRIVER=log
NOTIFICATION_SMS_SENDER="BILLET"
